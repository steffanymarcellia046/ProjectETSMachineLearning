    {
      "cell_type": "code",
      "source": [
        "from sklearn.metrics import mean_absolute_error, mean_squared_error\n",
        "import numpy as np\n",
        "\n",
        "y = daily[\"jumlah_penjualan\"]\n",
        "\n",
        "\n",
        "yhat_baseline = y.shift(7).loc[test.index]\n",
        "\n",
        "\n",
        "hasil = pd.DataFrame({\n",
        "    \"aktual\": test[\"jumlah_penjualan\"],\n",
        "    \"prediksi_baseline\": yhat_baseline\n",
        "}).dropna()\n",
        "\n",
        "mae = mean_absolute_error(\n",
        "    hasil[\"aktual\"], hasil[\"prediksi_baseline\"]\n",
        ")\n",
        "\n",
        "rmse = np.sqrt(mean_squared_error(\n",
        "    hasil[\"aktual\"], hasil[\"prediksi_baseline\"]\n",
        "))\n",
        "\n",
        "print(\"Baseline MAE:\", round(mae, 3))\n",
        "print(\"Baseline RMSE:\", round(rmse, 3))"
      ],
