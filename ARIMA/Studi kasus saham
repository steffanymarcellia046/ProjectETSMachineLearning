        "# Batas ekstrem untuk eksplorasi awal\n",
        "mu = returns.mean()\n",
        "sigma = returns.std()\n",
        "\n",
        "lower = mu - 3 * sigma\n",
        "upper = mu + 3 * sigma\n",
        "\n",
        "extreme_returns = returns[(returns < lower) | (returns > upper)]\n",
