        "stats.loc[\"Kurtosis (excess)\"] = returns.kurtosis()\n",
        "stats.loc[\"Jumlah return positif\"] = (returns > 0).sum()\n",
        "stats.loc[\"Jumlah return negatif\"] = (returns < 0).sum()\n",
        "stats.loc[\"Jumlah return nol\"] = (returns == 0).sum()\n",
        "\n",
        "display(stats)\n",
